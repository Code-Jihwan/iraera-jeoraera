# 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. 아무것도 채우지 않아도 예시 데이터 + 기본 엔진으로 동작합니다.
# .env 는 저장소에 올리지 마세요(.gitignore에 들어 있습니다).

# ── 서버 ─────────────────────────────────────────────
PORT=3000
# 기본은 이 컴퓨터에서만 접속(127.0.0.1). 다른 기기에서 접속하게 하려면 0.0.0.0 으로 바꾸고 아래 두 값을 함께 설정하세요.
HOST=127.0.0.1
# 외부에서 접속할 때 쓰는 호스트 이름(쉼표로 구분). 예: PUBLIC_HOSTS=demo.example.com
PUBLIC_HOSTS=
# 운영 화면(/ops.html) 보호용 토큰. 비워 두면 서버를 띄운 컴퓨터에서 localhost로 직접 연 경우에만 운영 화면이 열립니다
# (같은 컴퓨터의 프록시를 거친 요청이나 공개 호스트 이름으로 온 요청은 막습니다). 원격에서 쓰려면 꼭 설정하세요.
ADMIN_TOKEN=
# 같은 컴퓨터의 HTTPS 리버스 프록시(nginx, Caddy 등) 뒤에서 돌릴 때만 true. X-Forwarded-For로 손님 주소를 구분해 요청 제한을 겁니다.
TRUST_PROXY=false

# ── 서버 기록 보관 기간(일) ──────────────────────────
# 생성·반응 기록(문구 내용 없음, 익명 ID)과 신고 기록. 지나면 자동으로 지웁니다. 화면의 고지 문구에도 이 값이 그대로 나옵니다.
EVENT_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=90

# ── 요청 제한 ───────────────────────────────────────
GENERATE_RATE_LIMIT_PER_MIN=12
# 한 손님(IP, IPv6는 /64)이 하루에 만들 수 있는 횟수 — 한 사람이 하루 LLM 한도를 다 쓰지 못하게
GENERATE_DAILY_LIMIT_PER_CLIENT=60
# 서비스명(가칭). 팀에서 이름을 정하면 여기만 바꾸면 됩니다.
SERVICE_NAME=나만의 유행어

# ── 생성 엔진 (LLM) ──────────────────────────────────
# 키를 넣으면 AI 엔진(Claude)으로 유행어를 만들고 AI 안전 심사를 함께 돌립니다. 없으면 규칙 기반 기본 엔진으로 동작합니다.
ANTHROPIC_API_KEY=
# auto(키가 있으면 켬) | on | off
LLM_MODE=auto
LLM_MODEL=claude-opus-5-5
# 안전 심사에 쓸 모델(비우면 LLM_MODEL과 같음)
LLM_SAFETY_MODEL=
# low | medium | high | xhigh | max — 높을수록 느리고 비쌉니다
LLM_EFFORT=medium
# AI 안전 심사 on | off (끄면 금칙어 필터만 적용)
LLM_SAFETY_JUDGE=on
# 하루 LLM 호출 상한(비용 보호). 넘으면 기본 엔진으로 동작합니다.
LLM_DAILY_CALL_CAP=500

# ── 트렌드 수집 (YouTube Data API v3) ────────────────
# 키를 넣으면 인기 차트(제목·태그)에서 키워드를 수집합니다. 없으면 예시 데이터만 보여 줍니다.
YOUTUBE_API_KEY=
YOUTUBE_REGION=KR
# 0 = 전체 차트. 뉴스·정치(25)는 사건·참사 희화화 위험 때문에 기본에서 뺐습니다.
YOUTUBE_CATEGORY_IDS=0,10,20,22,23,24,26
# 갱신 주기(분)
TREND_REFRESH_MINUTES=180
# manual: 운영 화면에서 사람이 승인해야 노출 | auto: 금칙어 필터만 통과하면 바로 노출
TREND_REVIEW_MODE=manual
# 수집 데이터 보관 일수(YouTube 정책상 30일 이내)
TREND_TTL_DAYS=7

# ── 인스타그램 해시태그 반응 확인 (선택) ─────────────
# 비즈니스·크리에이터 계정과 앱 심사가 필요합니다. 둘 다 채워야 켜집니다. 최근 7일 30개 한도를 넘지 않게 관리합니다.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v27.0
IG_MAX_HASHTAGS_PER_RUN=3

# ── 성공 지표 목표(임시값 — 팀에서 확정) ─────────────
TARGET_STYLE_SCORE=4.0
TARGET_SAVE_SHARE_RATE=30
TARGET_TREND_LATENCY_HOURS=24
TARGET_HARMFUL_RATE=1
